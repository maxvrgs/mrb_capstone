{
  // Tailwind CSS v4 usa @theme/@apply dentro de globals.css.
  // El validador CSS integrado de VS Code no los conoce y los marca
  // como "Unknown at rule" (falsos positivos). Tailwind los procesa
  // correctamente en el build (PostCSS), así que se ignoran aquí.
  "css.lint.unknownAtRules": "ignore",
  "scss.lint.unknownAtRules": "ignore"
}
